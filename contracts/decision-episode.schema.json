{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-learning-work-system.local/contracts/decision-episode.schema.json",
  "title": "DecisionEpisode",
  "description": "A source-grounded business decision episode for Brain LoRA supervision. Version 0.1 is an unvalidated project contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "episode_id", "expert_id", "workflow_ref", "source",
    "task", "state_before", "narration", "decision", "operation", "outcome",
    "evidence", "review", "quality"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "episode_id": { "type": "string", "minLength": 1 },
    "expert_id": { "type": "string", "minLength": 1 },
    "workflow_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_id", "version"],
      "properties": {
        "workflow_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "node_id": { "type": "string" },
        "method_id": { "type": "string" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_kind", "sha256"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_kind": {
          "enum": ["new_event_recording", "legacy_video", "live_task_trace", "mixed", "project_owner_specification"]
        },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "platform": { "type": "string" },
        "application": { "type": "string" },
        "recording_session_id": { "type": "string" },
        "recorder_version": { "type": "string" },
        "source_duration_ms": { "type": "integer", "minimum": 0 },
        "course_id": { "type": "string" },
        "tutorial_id": { "type": "string" },
        "software_version": { "type": "string" }
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["goal", "success_criteria"],
      "properties": {
        "business_domain": { "type": "string" },
        "goal": { "type": "string", "minLength": 1 },
        "user_request": { "type": "string" },
        "success_criteria": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/criterion" }
        },
        "business_constraints": {
          "type": "array", "items": { "type": "string" }
        },
        "risk_level": { "enum": ["low", "medium", "high", "critical", "unknown"] },
        "applicable_conditions": {
          "type": "array", "items": { "$ref": "#/$defs/condition" }
        }
      }
    },
    "state_before": { "$ref": "#/$defs/state" },
    "narration": {
      "type": "array", "items": { "$ref": "#/$defs/narration_segment" }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": [
        "decision_type", "selected_strategy", "rationale_summary", "decision_basis",
        "applicable_conditions", "selected_next_step", "evidence_refs"
      ],
      "properties": {
        "decision_type": {
          "enum": [
            "task_decomposition", "step_selection", "sequence_decision",
            "branch_selection", "parameter_decision", "exception_handling",
            "recovery", "stop_decision", "completion_decision", "verify_state"
          ]
        },
        "selected_strategy": { "type": "string", "minLength": 1 },
        "rationale_summary": {
          "type": "string",
          "description": "Concise, externally auditable reason; do not store private chain-of-thought."
        },
        "decision_basis": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "enum": [
              "instructor_explicit", "behavioral_inference", "workflow_rule",
              "execution_feedback", "user_provided", "model_inference", "unknown"
            ]
          }
        },
        "applicable_conditions": {
          "type": "array", "items": { "$ref": "#/$defs/condition" }
        },
        "selected_next_step": { "$ref": "#/$defs/decision_action" },
        "alternatives_considered": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["strategy", "reason_not_selected"],
            "properties": {
              "strategy": { "type": "string" },
              "reason_not_selected": { "type": "string" },
              "evidence_refs": { "$ref": "#/$defs/string_array" }
            }
          }
        },
        "uncertainties": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "$ref": "#/$defs/string_array" }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["execution_status", "event_refs"],
      "properties": {
        "capability_id": { "type": "string" },
        "operation_objective": { "type": "string" },
        "parameters": { "type": "object" },
        "execution_status": {
          "enum": ["succeeded", "failed", "partially_succeeded", "not_executed", "not_observed", "unknown"]
        },
        "event_refs": { "$ref": "#/$defs/string_array" },
        "execution_trace_ref": { "type": "string" }
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "postcondition_checks", "next_action"],
      "properties": {
        "status": {
          "enum": ["success", "failure", "partial_success", "blocked", "unknown", "not_verified"]
        },
        "state_after": { "$ref": "#/$defs/state" },
        "postcondition_checks": {
          "type": "array", "items": { "$ref": "#/$defs/postcondition_check" }
        },
        "failure_category": { "type": "string" },
        "recovery_action": { "type": "string" },
        "next_action": {
          "enum": ["delegate", "ask_user", "request_approval", "replan", "finish", "stop"]
        },
        "next_step_reason": { "type": "string" }
      }
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "approved_for_training"],
      "properties": {
        "status": { "enum": ["draft", "needs_review", "approved", "rejected"] },
        "approved_for_training": { "type": "boolean" },
        "reviewer_id": { "type": "string" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "review_notes": { "type": "string" }
      }
    },
    "quality": {
      "type": "object", "additionalProperties": false,
      "required": ["annotation_status", "trainable", "exclusion_reasons"],
      "properties": {
        "annotation_status": {
          "enum": ["auto_extracted", "human_reviewed", "gold", "rejected"]
        },
        "trainable": { "type": "boolean" },
        "exclusion_reasons": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "string_array": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "description"],
      "properties": {
        "criterion_id": { "type": "string" },
        "description": { "type": "string" },
        "verification_type": {
          "enum": ["state_check", "business_result", "human_confirmation", "external_system", "unknown"]
        }
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["facts"],
      "properties": {
        "application": { "type": "string" },
        "page": { "type": "string" },
        "url": { "type": "string" },
        "business_state": { "type": "object" },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } }
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "path", "value", "evidence_refs"],
      "properties": {
        "fact_id": { "type": "string" },
        "path": { "type": "string" },
        "value": {},
        "evidence_refs": { "$ref": "#/$defs/string_array" }
      }
    },
    "narration_segment": {
      "type": "object", "additionalProperties": false,
      "required": ["segment_id", "start_ms", "end_ms", "speaker_role", "text", "evidence_refs"],
      "properties": {
        "segment_id": { "type": "string" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "speaker_role": { "enum": ["instructor", "user", "other", "unknown"] },
        "text": { "type": "string" },
        "transcript_method": { "enum": ["human_transcript", "subtitle", "asr", "unknown"] },
        "words": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["text", "start_ms", "end_ms"],
            "properties": {
              "text": { "type": "string" },
              "start_ms": { "type": "integer", "minimum": 0 },
              "end_ms": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "evidence_refs": { "$ref": "#/$defs/string_array" }
      }
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "operator", "value"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "operator": {
          "enum": [
            "equals", "not_equals", "in", "not_in", "exists", "not_exists",
            "greater_than", "greater_than_or_equal", "less_than", "less_than_or_equal"
          ]
        },
        "value": {}
      }
    },
    "decision_action": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "objective"],
      "properties": {
        "action": {
          "enum": ["delegate", "ask_user", "request_approval", "replan", "finish", "stop"]
        },
        "objective": { "type": "string", "minLength": 1 },
        "capability_id": { "type": "string" },
        "arguments": { "type": "object" },
        "question": { "type": "string" },
        "workflow_method_id": { "type": "string" },
        "expected_postconditions": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "postcondition_check": {
      "type": "object", "additionalProperties": false,
      "required": ["condition", "result", "evidence_refs"],
      "properties": {
        "condition": { "type": "string" },
        "result": { "enum": ["passed", "failed", "unknown", "not_checked"] },
        "observed_value": {},
        "evidence_refs": { "$ref": "#/$defs/string_array" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": [
        "evidence_id", "evidence_type", "observation_channel", "rationale_source",
        "confidence", "source_locator", "claim"
      ],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "evidence_type": {
          "enum": ["ui_event", "narration", "video_segment", "business_result", "human_annotation", "user_specification", "other"]
        },
        "observation_channel": {
          "enum": ["direct_capture", "inferred_from_video", "not_applicable", "unknown"]
        },
        "rationale_source": {
          "enum": ["instructor_explicit", "behavioral_inference", "hybrid", "not_applicable", "unknown"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "labels": {
          "type": "array", "uniqueItems": true,
          "items": { "const": "user_provided" }
        },
        "capture_method": { "type": "string" },
        "source_locator": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "start_ms": { "type": "integer", "minimum": 0 },
            "end_ms": { "type": "integer", "minimum": 0 },
            "event_ids": { "$ref": "#/$defs/string_array" },
            "transcript_segment_ids": { "$ref": "#/$defs/string_array" },
            "external_ref": { "type": "string" }
          }
        },
        "raw_record_ref": { "type": "string" },
        "claim": { "type": "string", "minLength": 1 }
      }
    }
  }
}