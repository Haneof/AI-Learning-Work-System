{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-learning-work-system.local/contracts/brain-hands-protocol.schema.json",
  "title": "BrainHandsProtocol",
  "description": "Versioned high-level delegation and execution-result messages between the workflow-reasoning Brain and an existing GUI operation Hands model.",
  "oneOf": [
    { "$ref": "#/$defs/delegation" },
    { "$ref": "#/$defs/execution_result" }
  ],
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator", "value"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "in",
            "not_in",
            "exists",
            "not_exists",
            "greater_than",
            "greater_than_or_equal",
            "less_than",
            "less_than_or_equal"
          ]
        },
        "value": {}
      }
    },
    "workflow_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "version", "node_id"],
      "properties": {
        "workflow_id": { "type": "string" },
        "version": { "type": "string" },
        "node_id": { "type": "string" }
      }
    },
    "postcondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "path", "operator", "value"],
      "properties": {
        "condition_id": { "type": "string" },
        "path": { "type": "string" },
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "in",
            "not_in",
            "exists",
            "not_exists"
          ]
        },
        "value": {}
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "message_type",
        "call_id",
        "task_id",
        "workflow_ref",
        "objective",
        "preconditions",
        "constraints",
        "expected_postconditions",
        "observation_requirements",
        "safety",
        "idempotency_key"
      ],
      "properties": {
        "protocol_version": { "const": "0.1" },
        "message_type": { "const": "operation_delegation" },
        "call_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "workflow_ref": { "$ref": "#/$defs/workflow_ref" },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "capability_id", "arguments"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "capability_id": { "type": "string", "minLength": 1 },
            "arguments": { "type": "object" }
          }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition" }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["must_not", "allowed_scope"],
          "properties": {
            "must": {
              "type": "array",
              "items": { "type": "string" }
            },
            "must_not": {
              "type": "array",
              "items": { "type": "string" }
            },
            "allowed_scope": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "expected_postconditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/postcondition" }
        },
        "observation_requirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["risk_level", "requires_human_approval"],
          "properties": {
            "risk_level": {
              "enum": ["low", "medium", "high", "critical", "unknown"]
            },
            "requires_human_approval": { "type": "boolean" },
            "approval_ref": { "type": "string" }
          }
        },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "execution_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "message_type",
        "call_id",
        "task_id",
        "status",
        "result_summary",
        "observed_state",
        "postcondition_results",
        "actions_summary",
        "error",
        "evidence_refs",
        "completed_at"
      ],
      "properties": {
        "protocol_version": { "const": "0.1" },
        "message_type": { "const": "operation_result" },
        "call_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "partially_succeeded",
            "blocked",
            "needs_observation",
            "timed_out",
            "cancelled"
          ]
        },
        "result_summary": { "type": "string" },
        "observed_state": { "type": "object" },
        "postcondition_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["condition_id", "result", "evidence_refs"],
            "properties": {
              "condition_id": { "type": "string" },
              "result": {
                "enum": ["passed", "failed", "unknown", "not_checked"]
              },
              "observed_value": {},
              "evidence_refs": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "actions_summary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "status"],
            "properties": {
              "action": { "type": "string" },
              "status": {
                "enum": [
                  "succeeded",
                  "failed",
                  "partially_succeeded",
                  "skipped",
                  "unknown"
                ]
              },
              "detail": { "type": "string" }
            }
          }
        },
        "error": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "code", "message"],
              "properties": {
                "category": { "type": "string" },
                "code": { "type": "string" },
                "message": { "type": "string" },
                "retryable": { "type": "boolean" }
              }
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "trace_ref": { "type": "string" },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}